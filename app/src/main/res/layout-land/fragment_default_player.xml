<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@drawable/radial_gradient"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:src="@tools:sample/backgrounds/scenic"/>

    <!-- 🛡️ 兼容性占位符：满足 DefaultPlayerControlsFragment 对旧 ID 的引用 -->
    <TextView
        android:id="@+id/leftCoverInfoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ================= 左侧区域：绝对扁平化，0 嵌套 ================= -->

    <!-- 中间：直接用封面自身作为 1:1 核心锚点，没有任何外层包裹 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/playerAlbumCoverFragment"
        android:name="com.mardous.booming.ui.screen.player.cover.CoverPagerFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="24dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/inlineProgressSlider"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout="@layout/fragment_album_cover_default"/>

    <!-- 底部：迷你进度条。左右死死咬住封面的左右边缘 -->
    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/inlineProgressSlider"
        android:layout_width="0dp"
        android:layout_height="24dp" 
        android:layout_marginBottom="16dp"   
        android:background="@null"
        android:stateListAnimator="@null"
        android:focusable="false"
        android:splitTrack="false"
        android:thumb="@null"
        android:minHeight="6dp"
        android:maxHeight="6dp"
        android:progressTint="?android:attr/textColorPrimary"
        app:layout_constraintBottom_toBottomOf="parent" 
        app:layout_constraintStart_toStartOf="@+id/playerAlbumCoverFragment"
        app:layout_constraintEnd_toEndOf="@+id/playerAlbumCoverFragment" />

    <!-- ================= 右侧区域：全部锚定封面右边缘 ================= -->

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/playbackControlsFragment"
        android:name="com.mardous.booming.ui.screen.player.styles.defaultstyle.DefaultPlayerControlsFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/toolbar"
        app:layout_constraintStart_toEndOf="@+id/playerAlbumCoverFragment"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout="@layout/fragment_default_player_playback_controls"/>

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?actionBarSize"
        android:theme="@style/ThemeOverlay.MaterialComponents.ActionBar"
        android:elevation="0dp"
        app:navigationIcon="@drawable/ic_volume_up_24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/playbackControlsFragment"
        app:layout_constraintEnd_toEndOf="@+id/playbackControlsFragment"
        tools:menu="@menu/menu_now_playing"/>

    <!-- 歌名与歌手信息 -->
    <!-- 歌名与歌手信息及红心收藏 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rightSongInfoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"       
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:visibility="invisible"           
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/playerAlbumCoverFragment"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/rightSongTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="18sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold"
            android:includeFontPadding="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintHorizontal_bias="0.0" 
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/rightSongArtistText"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 增加 layout_marginEnd 让文字即使过长，也会在红心前自动省略，绝不重叠 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/rightSongArtistText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="16sp"
            android:alpha="0.7"
            android:textColor="?android:attr/textColorSecondary"  
            android:includeFontPadding="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toEndOf="@+id/rightSongTitleText"
            app:layout_constraintEnd_toStartOf="@+id/rightFavoriteButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 🌟 右侧红心收藏按钮 (脱离 Chain 链条，钉死在 parent 最右侧) -->
        <ImageView
            android:id="@+id/rightFavoriteButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:alpha="0.8"
            android:src="@drawable/ic_favorite_outline_24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 纯净歌词容器 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/rightLyricsFragment"
        android:name="com.mardous.booming.ui.screen.player.cover.CoverLyricsFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"       
        android:visibility="invisible"
        android:elevation="5dp" 
        app:layout_constraintTop_toBottomOf="@+id/rightSongInfoContainer" 
        app:layout_constraintBottom_toBottomOf="parent" 
        app:layout_constraintStart_toEndOf="@+id/playerAlbumCoverFragment"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>