<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@drawable/radial_gradient"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:src="@tools:sample/backgrounds/scenic"/>

    <!-- ================= 左侧区域：封面自适应最大化 + 极简底部坞 ================= -->

    <!-- 1. 极致最大化的专辑封面 (纯净容器，阴影交由原作者内部处理，0性能浪费) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/playerAlbumCoverFragment"
        android:name="com.mardous.booming.ui.screen.player.cover.CoverPagerFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/leftSongInfoText"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout="@layout/fragment_album_cover_default"/>

    <!-- 2. 状态坞第一行：歌名 · 歌手 -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/leftSongInfoText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:textSize="16sp"
        android:textColor="?android:attr/textColorPrimary"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/leftFavoriteButton"
        app:layout_constraintBottom_toTopOf="@+id/leftProgressSlider"
        tools:text="孤勇者 · 陈奕迅" />

    <!-- 3. 红心按钮 (完美对齐封面右侧边缘) -->
    <ImageView
        android:id="@+id/leftFavoriteButton"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="0dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:src="@drawable/ic_favorite_outline_24dp"
        app:layout_constraintEnd_toEndOf="@+id/playerAlbumCoverFragment"
        app:layout_constraintTop_toTopOf="@+id/leftSongInfoText"
        app:layout_constraintBottom_toBottomOf="@+id/leftSongInfoText" />

    <!-- 4. 状态坞第二行左侧：当前时间 -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/leftCurrentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="12dp"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="?android:attr/textColorSecondary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="01:23" />

    <!-- 5. 状态坞第二行右侧：总时长 -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/leftTotalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="?android:attr/textColorSecondary"
        app:layout_constraintEnd_toEndOf="@+id/playerAlbumCoverFragment"
        app:layout_constraintBottom_toBottomOf="@+id/leftCurrentTime"
        app:layout_constraintTop_toTopOf="@+id/leftCurrentTime"
        tools:text="03:45" />

    <!-- 6. 状态坞第二行中间：主进度条 -->
    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/leftProgressSlider"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@null"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:maxHeight="4dp"
        android:minHeight="4dp"
        android:splitTrack="false"
        android:progressTint="?android:attr/textColorPrimary"
        android:thumbTint="?android:attr/textColorPrimary"
        app:layout_constraintStart_toEndOf="@+id/leftCurrentTime"
        app:layout_constraintEnd_toStartOf="@+id/leftTotalTime"
        app:layout_constraintBottom_toBottomOf="@+id/leftCurrentTime"
        app:layout_constraintTop_toTopOf="@+id/leftCurrentTime" />


    <!-- ================= 右侧区域：动态自适应剩余空间 ================= -->

    <!-- 控制面板 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/playbackControlsFragment"
        android:name="com.mardous.booming.ui.screen.player.styles.defaultstyle.DefaultPlayerControlsFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/toolbar"
        app:layout_constraintStart_toEndOf="@+id/playerAlbumCoverFragment"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout="@layout/fragment_default_player_playback_controls"/>

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?actionBarSize"
        android:theme="@style/ThemeOverlay.MaterialComponents.ActionBar"
        android:elevation="0dp"
        app:navigationIcon="@drawable/ic_volume_up_24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/playerAlbumCoverFragment"
        app:layout_constraintEnd_toEndOf="parent"
        tools:menu="@menu/menu_now_playing"/>

    <!-- 纯净歌词容器 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/rightLyricsFragment"
        android:name="com.mardous.booming.ui.screen.player.cover.CoverLyricsFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="16dp"
        android:visibility="invisible"
        android:elevation="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/playerAlbumCoverFragment"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>