<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@drawable/radial_gradient"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:src="@tools:sample/backgrounds/scenic"/>

    <TextView
        android:id="@+id/leftCoverInfoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ================= 左侧区域 ================= -->

    <!-- 1. 自适应最大化封面 -->
    <!-- 1. 封面：左右留出 20dp 的安全边距，1:1 自动居中 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/playerAlbumCoverFragment"
        android:name="com.mardous.booming.ui.screen.player.cover.CoverPagerFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="20dp"   
        android:layout_marginEnd="20dp"    
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/leftSongInfoContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/playbackControlsFragment"
        tools:layout="@layout/fragment_album_cover_default"/>

    <!-- 2. 歌名信息：左右边距设为 8dp（比封面小），自然比封面更宽 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/leftSongInfoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="2dp"     
        android:layout_marginEnd="2dp"      
        app:layout_constraintBottom_toTopOf="@+id/leftProgressContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/playbackControlsFragment">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/leftSongTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold"
            android:includeFontPadding="false" 
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintHorizontal_bias="0.0" 
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/leftSongArtistText"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/leftSongArtistText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="14sp"
            android:alpha="0.7"
            android:textColor="?android:attr/textColorSecondary"  
            android:includeFontPadding="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toEndOf="@+id/leftSongTitleText"
            app:layout_constraintEnd_toStartOf="@+id/leftFavoriteButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/leftFavoriteButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:alpha="0.8"
            android:src="@drawable/ic_favorite_outline_24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. 进度条容器：左右边距同样设为 8dp，形成完美的超宽悬浮底座 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/leftProgressContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"    
        android:layout_marginEnd="2dp"      
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/playbackControlsFragment">

        <!-- 左侧当前时间 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/leftCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="8sp"
            android:textColor="?android:attr/textColorSecondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="01:23" />

        <!-- 中间 Mini 进度条 -->
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/inlineProgressSlider"
            android:layout_width="0dp"
            android:layout_height="24dp" 
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@null"
            android:stateListAnimator="@null"
            android:focusable="false"
            android:splitTrack="false"
            android:thumb="@null"
            android:minHeight="6dp"
            android:maxHeight="6dp"
            android:progressTint="?android:attr/textColorPrimary"
            app:layout_constraintBottom_toBottomOf="parent" 
            app:layout_constraintStart_toEndOf="@+id/leftCurrentTime"
            app:layout_constraintEnd_toStartOf="@+id/leftTotalTime"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 右侧总时长 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/leftTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="8sp"
            android:textColor="?android:attr/textColorSecondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="03:45" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= 右侧区域 (原封不动) ================= -->

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/playbackControlsFragment"
        android:name="com.mardous.booming.ui.screen.player.styles.defaultstyle.DefaultPlayerControlsFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/toolbar"
        app:layout_constraintStart_toEndOf="@+id/playerAlbumCoverFragment"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout="@layout/fragment_default_player_playback_controls"/>

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?actionBarSize"
        android:theme="@style/ThemeOverlay.MaterialComponents.ActionBar"
        android:elevation="0dp"
        app:navigationIcon="@drawable/ic_volume_up_24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/playbackControlsFragment"
        app:layout_constraintEnd_toEndOf="@+id/playbackControlsFragment"
        tools:menu="@menu/menu_now_playing"/>

    <!-- 歌词容器 (直接铺满右侧，原本上面的 Info 已经被移走了) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/rightLyricsFragment"
        android:name="com.mardous.booming.ui.screen.player.cover.CoverLyricsFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"       
        android:visibility="invisible"
        android:elevation="5dp" 
        app:layout_constraintTop_toTopOf="parent" 
        app:layout_constraintBottom_toBottomOf="parent" 
        app:layout_constraintStart_toEndOf="@+id/playerAlbumCoverFragment"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>