<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@drawable/radial_gradient"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:src="@tools:sample/backgrounds/scenic"/>

    <!-- 辅助参考线：左45%和右55% -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/center_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.45" />
	<!-- 🛡️ 兼容性占位符：满足 DefaultPlayerControlsFragment 对旧 ID 的引用，避免编译报错 -->
    <TextView
        android:id="@+id/leftCoverInfoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ================= 左侧区域：极简封面 + 底部进度条 ================= -->

    <!-- 中间：封面容器 (已移至最顶部中央) layout_marginBottom 底部距离-->
    <FrameLayout
        android:id="@+id/coverContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="0dp"      
        android:layout_marginBottom="8dp"   
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintDimensionRatio="1:1"  
        app:layout_constraintTop_toTopOf="parent" 
        app:layout_constraintBottom_toTopOf="@+id/inlineProgressSlider"  
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/center_guideline">
        
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/playerAlbumCoverFragment"
            android:name="com.mardous.booming.ui.screen.player.cover.CoverPagerFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:layout="@layout/fragment_album_cover_default"/>
    </FrameLayout>

    <!-- 底部：迷你进度条 layout_marginBottom 进度条距离屏幕底部的极限高度 -->
    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/inlineProgressSlider"
        android:layout_width="0dp"
        android:layout_height="24dp" 
        android:layout_marginBottom="15dp"   
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@null"
        android:stateListAnimator="@null"
        android:focusable="false"
        android:splitTrack="false"
        android:thumb="@null"
        android:minHeight="4dp"
        android:maxHeight="4dp"
        android:progressTint="?android:attr/textColorPrimary"
        app:layout_constraintBottom_toBottomOf="parent" 
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/center_guideline" />


    <!-- ================= 右侧区域：控制面板 OR 歌词 + 歌名组合 ================= -->

    <!-- 右侧：控制面板 (不受影响) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/playbackControlsFragment"
        android:name="com.mardous.booming.ui.screen.player.styles.defaultstyle.DefaultPlayerControlsFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/toolbar"
        app:layout_constraintStart_toEndOf="@+id/center_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout="@layout/fragment_default_player_playback_controls"/>

    <!-- 右侧：底部菜单栏 (不受影响) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?actionBarSize"
        android:theme="@style/ThemeOverlay.MaterialComponents.ActionBar"
        android:elevation="0dp"
        app:navigationIcon="@drawable/ic_volume_up_24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/playbackControlsFragment"
        app:layout_constraintEnd_toEndOf="@+id/playbackControlsFragment"
        tools:menu="@menu/menu_now_playing"/>

    <!-- ================= 核心重构：右侧顶部的歌名与歌手信息 layout_marginTop 歌名距离屏幕顶部的距离 (建议 12dp ~ 32dp 避开状态栏) ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rightSongInfoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"       
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:visibility="gone"           
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/center_guideline"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 歌名：加粗，高亮主色  -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/rightSongTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold"
            android:includeFontPadding="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_chainStyle="packed"  
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/rightSongArtistText"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 歌手：不加粗，灰色次级文本 layout_marginStart 歌名和歌手名之间的间距 (建议 6dp ~ 10dp) -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/rightSongArtistText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"    
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="15sp"
			android:alpha="0.7"
            android:textColor="?android:attr/textColorSecondary"  
            android:includeFontPadding="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toEndOf="@+id/rightSongTitleText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 右侧：纯净歌词容器 (悬挂在歌名下方) layout_marginTop 下方歌词距离上方歌名/歌手的间距 (建议 12dp ~ 24dp) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/rightLyricsFragment"
        android:name="com.mardous.booming.ui.screen.player.cover.CoverLyricsFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"       
        android:visibility="gone"
        android:elevation="5dp" 
        app:layout_constraintTop_toBottomOf="@+id/rightSongInfoContainer" 
        app:layout_constraintBottom_toBottomOf="parent" 
        app:layout_constraintStart_toEndOf="@+id/center_guideline"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>