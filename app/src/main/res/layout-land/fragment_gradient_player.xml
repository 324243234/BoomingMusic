<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true">

    <!-- 严格保留源作者的内部 ConstraintLayout 及 ID -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/colorBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ================= 左侧区域 ================= -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/playerAlbumCoverFragment"
            android:name="com.mardous.booming.ui.screen.player.cover.CoverPagerFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:layout="@layout/fragment_album_cover"/>

        <!-- 补充注入：动态视频背景 -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/canvasPlayerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            app:use_controller="false"
            app:surface_type="texture_view"
            android:clickable="false"
            android:focusable="false"
            app:layout_constraintTop_toTopOf="@+id/playerAlbumCoverFragment"
            app:layout_constraintBottom_toBottomOf="@+id/playerAlbumCoverFragment"
            app:layout_constraintStart_toStartOf="@+id/playerAlbumCoverFragment"
            app:layout_constraintEnd_toEndOf="@+id/playerAlbumCoverFragment" />

        <View
            android:id="@+id/mask"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/shadow_start_gradient"
            app:layout_constraintBottom_toBottomOf="@id/playerAlbumCoverFragment"
            app:layout_constraintEnd_toEndOf="@id/playerAlbumCoverFragment"
            app:layout_constraintStart_toStartOf="@id/playerAlbumCoverFragment"
            app:layout_constraintTop_toTopOf="@id/playerAlbumCoverFragment"
            tools:backgroundTint="?colorSurface"/>

        <!-- ================= 右侧主播放面板 ================= -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/playbackControlsFragment"
            android:name="com.mardous.booming.ui.screen.player.styles.gradientstyle.GradientPlayerControlsFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/bottomActionContainer"
            app:layout_constraintStart_toEndOf="@+id/playerAlbumCoverFragment"
            app:layout_constraintEnd_toEndOf="parent"
            tools:layout="@layout/fragment_gradient_player_playback_controls"/>

        <LinearLayout
            android:id="@+id/bottomActionContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp"
            android:gravity="center_horizontal"
            app:layout_constraintStart_toStartOf="@id/playbackControlsFragment"
            app:layout_constraintEnd_toEndOf="@id/playbackControlsFragment"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openQueueButton"
                style="?materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/playing_queue_label"
                app:icon="@drawable/ic_queue_music_24dp"
                app:iconTint="?colorOnSurface"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showLyricsButton"
                style="?materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/action_show_lyrics"
                app:icon="@drawable/ic_lyrics_outline_24dp"
                app:iconTint="?colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/soundSettingsButton"
                style="?materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/sound_settings"
                app:icon="@drawable/ic_volume_up_24dp"
                app:iconTint="?colorOnSurface" />

        </LinearLayout>

        <!-- ★★★ 补充注入：右侧歌词面板（修复了链条约束关系） ★★★ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rightLyricsContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="invisible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/playerAlbumCoverFragment"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 1. 歌词滚动区 -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/rightLyricsFragment"
                android:name="com.mardous.booming.ui.screen.player.cover.CoverLyricsFragment"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/lyricsExtraInfoContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 2. 底部控制信息区 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lyricsExtraInfoContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingBottom="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- 🌟 歌名：建立水平 Chain，与歌手绑定并靠左(bias=0.0) -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/lyricsSongTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:includeFontPadding="false"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/lyricsFavoriteButton"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 🌟 歌手名：作为 Chain 的后半段，自适应宽度并展示二级颜色 -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/lyricsSongArtistText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:includeFontPadding="false"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toEndOf="@+id/lyricsSongTitleText"
                    app:layout_constraintEnd_toStartOf="@+id/lyricsFavoriteButton"
                    app:layout_constraintBottom_toBottomOf="@+id/lyricsSongTitleText"
                    app:layout_constraintTop_toTopOf="@+id/lyricsSongTitleText" />

                <!-- 🌟 收藏按钮：独立于 Title/Artist 链条之外，紧贴下一首按钮 -->
                <ImageView
                    android:id="@+id/lyricsFavoriteButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_favorite_outline_24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:layout_constraintEnd_toStartOf="@+id/lyricsNextButton"
                    app:layout_constraintTop_toTopOf="@+id/lyricsSongTitleText"
                    app:layout_constraintBottom_toBottomOf="@+id/lyricsSongTitleText" />

                <!-- 🌟 下一首按钮：靠拢父容器最右侧边缘 -->
                <ImageView
                    android:id="@+id/lyricsNextButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_next_24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/lyricsSongTitleText"
                    app:layout_constraintBottom_toBottomOf="@+id/lyricsSongTitleText" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/lyricsCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minWidth="36dp"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:gravity="center"
                    android:textColor="?android:attr/textColorSecondary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/lyricsSongTitleText" />

                <androidx.appcompat.widget.AppCompatSeekBar
                    android:id="@+id/lyricsInlineProgressSlider"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="4dp"
                    android:background="@null"
                    android:splitTrack="false"
                    android:thumb="@null"
                    android:minHeight="6dp"
                    android:maxHeight="6dp"
                    app:layout_constraintBottom_toBottomOf="@+id/lyricsCurrentTime"
                    app:layout_constraintTop_toTopOf="@+id/lyricsCurrentTime"
                    app:layout_constraintStart_toEndOf="@+id/lyricsCurrentTime"
                    app:layout_constraintEnd_toStartOf="@+id/lyricsTotalTime" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/lyricsTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minWidth="36dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/lyricsSongTitleText" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>