<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/colorBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ================= 左侧区域 ================= -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/playerAlbumCoverFragment"
            android:name="com.mardous.booming.ui.screen.player.cover.CoverPagerFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:layout="@layout/fragment_album_cover"/>

        <androidx.media3.ui.PlayerView
            android:id="@+id/canvasPlayerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            app:use_controller="false"
            app:surface_type="texture_view"
            android:clickable="false"
            android:focusable="false"
            app:layout_constraintTop_toTopOf="@+id/playerAlbumCoverFragment"
            app:layout_constraintBottom_toBottomOf="@+id/playerAlbumCoverFragment"
            app:layout_constraintStart_toStartOf="@+id/playerAlbumCoverFragment"
            app:layout_constraintEnd_toEndOf="@+id/playerAlbumCoverFragment" />

        <!-- ================= 右侧主播放面板 ================= -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/playbackControlsFragment"
            android:name="com.mardous.booming.ui.screen.player.styles.gradientstyle.GradientPlayerControlsFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/bottomActionContainer"
            app:layout_constraintStart_toEndOf="@+id/playerAlbumCoverFragment"
            app:layout_constraintEnd_toEndOf="parent"
            tools:layout="@layout/fragment_gradient_player_playback_controls"/>

        <!-- 动态底栏：包含了所有的按钮 -->
        <LinearLayout
            android:id="@+id/bottomActionContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="@+id/playbackControlsFragment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openQueueButton"
                style="?materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                app:icon="@drawable/ic_queue_music_24dp"
                app:iconTint="?colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showLyricsButton"
                style="?materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                app:icon="@drawable/ic_lyrics_outline_24dp"
                app:iconTint="?colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/goToArtistButton"
                style="?materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                app:icon="@drawable/ic_person_24dp"
                app:iconTint="?colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/goToAlbumButton"
                style="?materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                app:icon="@drawable/ic_album_24dp"
                app:iconTint="?colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggleLyricsFormatButton"
                style="?materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                app:icon="@drawable/ic_lyrics_24dp"
                app:iconTint="?colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/soundSettingsButton"
                style="?materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                app:icon="@drawable/ic_volume_up_24dp"
                app:iconTint="?colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/equalizerButton"
                style="?materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                app:icon="@drawable/ic_equalizer_24dp"
                app:iconTint="?colorOnSurface" />
        </LinearLayout>

        <!-- ★★★ 核心修复：单层极简容器，包含所有歌词和进度控件 ★★★ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rightLyricsContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="invisible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/playerAlbumCoverFragment"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 1. 内部歌词部分 -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/rightLyricsFragment"
                android:name="com.mardous.booming.ui.screen.player.cover.CoverLyricsFragment"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/lyricsSongTitleText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 2. 歌名：优先占据空间，照搬 Default 的弹性链条 -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/lyricsSongTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="8dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"
                android:includeFontPadding="false"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/lyricsFavoriteButton"
                app:layout_constraintBottom_toTopOf="@+id/lyricsCurrentTime" />

            <!-- 3. 歌手：见缝插针，跟在歌名后面 -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/lyricsSongArtistText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:includeFontPadding="false"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@+id/lyricsSongTitleText"
                app:layout_constraintEnd_toStartOf="@+id/lyricsFavoriteButton"
                app:layout_constraintTop_toTopOf="@+id/lyricsSongTitleText"
                app:layout_constraintBottom_toBottomOf="@+id/lyricsSongTitleText" />

            <!-- 4. 收藏按钮 -->
            <ImageView
                android:id="@+id/lyricsFavoriteButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@drawable/ic_favorite_outline_24dp"
                app:layout_constraintEnd_toStartOf="@+id/lyricsNextButton"
                app:layout_constraintTop_toTopOf="@+id/lyricsSongTitleText"
                app:layout_constraintBottom_toBottomOf="@+id/lyricsSongTitleText" />

            <!-- 5. 迷你下一首按钮 -->
            <ImageView
                android:id="@+id/lyricsNextButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="2dp"
                android:src="@drawable/ic_next_24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/lyricsSongTitleText"
                app:layout_constraintBottom_toBottomOf="@+id/lyricsSongTitleText" />

            <!-- 6. 当前时间 -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/lyricsCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="6dp"
                android:minWidth="36dp"
                android:gravity="center"
                android:textSize="12sp"
                android:singleLine="true"
                android:textColor="?android:attr/textColorSecondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="00:00" />

            <!-- 7. 进度条 -->
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/lyricsInlineProgressSlider"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:background="@null"
                android:splitTrack="false"
                android:thumb="@null"
                android:minHeight="6dp"
                android:maxHeight="6dp"
                app:layout_constraintBottom_toBottomOf="@+id/lyricsCurrentTime"
                app:layout_constraintTop_toTopOf="@+id/lyricsCurrentTime"
                app:layout_constraintStart_toEndOf="@+id/lyricsCurrentTime"
                app:layout_constraintEnd_toStartOf="@+id/lyricsTotalTime" />

            <!-- 8. 总时间 -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/lyricsTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:minWidth="36dp"
                android:gravity="center"
                android:textSize="12sp"
                android:singleLine="true"
                android:textColor="?android:attr/textColorSecondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/lyricsCurrentTime"
                app:layout_constraintBottom_toBottomOf="@+id/lyricsCurrentTime"
                tools:text="04:20" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>