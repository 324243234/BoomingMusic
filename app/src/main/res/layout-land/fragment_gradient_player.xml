<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/colorBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ================= 左侧区域 (1:1 封面 / 动态视频) ================= -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/playerAlbumCoverFragment"
            android:name="com.mardous.booming.ui.screen.player.cover.CoverPagerFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:layout="@layout/fragment_album_cover"/>

        <androidx.media3.ui.PlayerView
            android:id="@+id/canvasPlayerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            app:use_controller="false"
            app:surface_type="texture_view"
            android:clickable="false"
            android:focusable="false"
            app:layout_constraintTop_toTopOf="@+id/playerAlbumCoverFragment"
            app:layout_constraintBottom_toBottomOf="@+id/playerAlbumCoverFragment"
            app:layout_constraintStart_toStartOf="@+id/playerAlbumCoverFragment"
            app:layout_constraintEnd_toEndOf="@+id/playerAlbumCoverFragment" />

        <View
            android:id="@+id/mask"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/shadow_start_gradient"
            app:layout_constraintBottom_toBottomOf="@id/playerAlbumCoverFragment"
            app:layout_constraintEnd_toEndOf="@id/playerAlbumCoverFragment"
            app:layout_constraintStart_toStartOf="@id/playerAlbumCoverFragment"
            app:layout_constraintTop_toTopOf="@id/playerAlbumCoverFragment"
            tools:backgroundTint="?colorSurface"/>

        <!-- ================= 主控制台 ================= -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/playbackControlsFragment"
            android:name="com.mardous.booming.ui.screen.player.styles.gradientstyle.GradientPlayerControlsFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/bottomActionContainer"
            app:layout_constraintStart_toEndOf="@+id/playerAlbumCoverFragment"
            app:layout_constraintEnd_toEndOf="parent"
            tools:layout="@layout/fragment_gradient_player_playback_controls"/>

        <LinearLayout
            android:id="@+id/bottomActionContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="@+id/playbackControlsFragment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openQueueButton"
                style="?materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                app:icon="@drawable/ic_queue_music_24dp"
                app:iconTint="?colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showLyricsButton"
                style="?materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                app:icon="@drawable/ic_lyrics_outline_24dp"
                app:iconTint="?colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/goToArtistButton"
                style="?materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                app:icon="@drawable/ic_person_24dp"
                app:iconTint="?colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/goToAlbumButton"
                style="?materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                app:icon="@drawable/ic_album_24dp"
                app:iconTint="?colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggleLyricsFormatButton"
                style="?materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                app:icon="@drawable/ic_lyrics_24dp"
                app:iconTint="?colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/soundSettingsButton"
                style="?materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                app:icon="@drawable/ic_volume_up_24dp"
                app:iconTint="?colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/equalizerButton"
                style="?materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                app:icon="@drawable/ic_equalizer_24dp"
                app:iconTint="?colorOnSurface" />
        </LinearLayout>

        <!-- ================= 右侧沉浸式区域 ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rightLyricsContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="invisible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/playerAlbumCoverFragment"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 🌟 极度压缩的顶部信息栏：对齐状态栏，极致挤压高度 -->
            <LinearLayout
                android:id="@+id/lyricsTopHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="2dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/lyricsSongTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:includeFontPadding="false"
                    android:textColor="?android:attr/textColorPrimary"
                    tools:text="歌曲名称" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/lyricsSongArtistText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textSize="14sp"
                    android:includeFontPadding="false"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="歌手名称" />
            </LinearLayout>

            <!-- 歌词容器：最大限度占用空间 -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/rightLyricsFragment"
                android:name="com.mardous.booming.ui.screen.player.cover.CoverLyricsFragment"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                app:layout_constraintTop_toBottomOf="@+id/lyricsTopHeader"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 右下角悬浮胶囊 -->
            <LinearLayout
                android:id="@+id/lyricsFloatingCapsule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="60dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/lyricsFavoriteButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:layout_marginBottom="8dp"
					android:alpha="0.5"
                    android:src="@drawable/ic_favorite_outline_24dp"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <ImageView
                    android:id="@+id/lyricsNextButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
					android:alpha="0.5"
                    android:src="@drawable/ic_next_24dp"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>